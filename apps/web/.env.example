# 이 파일을 .env.local 로 복사해 값을 채운다. .env.local 은 커밋하지 않는다.
# 설정 방법은 docs/google-workspace-integration.md 참고.

# Google Cloud OAuth 2.0 클라이언트 ID (웹 애플리케이션 유형)
VITE_GOOGLE_CLIENT_ID=

# Google Picker 용 API 키 (HTTP 리퍼러로 제한할 것)
VITE_GOOGLE_API_KEY=

# Google Cloud 프로젝트 번호 (Picker setAppId, drive.file 권한 부여에 필요)
VITE_GOOGLE_APP_ID=

# 로그인을 허용할 학교 Workspace 도메인. 비워 두면 src/branding.json 의 bangok.hs.kr 을 쓴다.
VITE_ALLOWED_DOMAIN=

# 백엔드 API 주소. 비워 두면 백엔드 없이 동작한다 (기능 플래그는 /config.json 사용).
# Firebase Hosting 에서 /api 를 Cloud Run 으로 연결했다면 /api 로 둔다.
VITE_API_BASE=

# 개발 서버(npm run dev)에서만 Google 로그인 없이 테스트 계정으로 들어간다.
# 운영 빌드에서는 이 값과 관계없이 항상 꺼진다.
VITE_DEV_AUTH_BYPASS=true
